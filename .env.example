# Порт (на хостинге часто задаётся автоматически — тогда PORT не нужен)
PORT=8080

# Секрет для сессий админки — замените на длинную случайную строку
SESSION_SECRET=замените-на-случайную-строку

# Код входа в админ-панель /admin
ADMIN_CODE=260626MK

# production — для secure-cookie за HTTPS
NODE_ENV=production
